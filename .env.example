# IBM Quantum API Token
# IBM Quantum Experience (https://quantum.ibm.com/) でアカウントを作成し、
# APIトークンを取得してください
IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here

# IBM Quantum Instance (CRN)
# 複数のインスタンスがある場合に指定してください
# 例: crn:v1:bluemix:public:quantum-computing:us-east:a/xxx:yyy::
IBM_QUANTUM_INSTANCE=

# Flask Configuration
FLASK_SECRET_KEY=your_secret_key_here
FLASK_ENV=development
FLASK_PORT=5001